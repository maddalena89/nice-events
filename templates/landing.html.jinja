<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#1f3bff">
<title>{{ page.title }}</title>
<meta name="description" content="{{ page.description }}">
<link rel="canonical" href="{{ page.url }}">
<link rel="icon" href="/favicon-32.png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta property="og:site_name" content="What's on in Nice">
<meta property="og:title" content="{{ page.title }}">
<meta property="og:description" content="{{ page.description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ page.url }}">
<meta property="og:locale" content="en_GB">
<meta property="og:locale:alternate" content="fr_FR">
{%- if og_image %}
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{ og_image }}">
{%- endif %}
<meta name="twitter:title" content="{{ page.title }}">
<meta name="twitter:description" content="{{ page.description }}">
{#- Two blocks, doing two different jobs. The ItemList describes THIS page (a
    list of events, in order); the Event objects describe the things on it. Both
    are rendered from the same rows shown below, so they cannot drift. #}
<script type="application/ld+json">{{ page.jsonld|safe }}</script>
<style>
:root{color-scheme:light;--ink:#0e0e0e;--paper:#f4f2ed;--accent:#1f3bff;--muted:#7d7970;--rule:#d8d4cb}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--paper);color:var(--ink);font-family:"Helvetica Neue",Helvetica,Arial,sans-serif;font-size:15px;line-height:1.45;-webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding:0 28px 80px}
a{color:var(--accent)}
.eyebrow{display:flex;flex-wrap:wrap;gap:6px 16px;justify-content:space-between;align-items:baseline;
  font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);
  border-bottom:1px solid var(--ink);padding:26px 0 10px}
h1{font-size:clamp(38px,7vw,76px);line-height:.9;letter-spacing:-.04em;font-weight:800;
   margin:28px 0 0;text-transform:uppercase}
h1 em{font-style:normal;color:var(--accent)}
.lede{margin:18px 0 0;font-size:17px;line-height:1.45;max-width:62ch}
/* The French line is not decoration: it is the phrasing people actually type
   into a search box around here, and it belongs in the readable copy rather
   than stuffed into a meta tag where it helps nobody. */
.lede .fr{display:block;margin-top:6px;color:var(--muted);font-size:15px}
.count{margin:22px 0 0;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);
  border-top:1px solid var(--ink);padding-top:10px}
.daymark{display:flex;align-items:baseline;gap:10px;margin-top:26px;padding-bottom:5px;border-bottom:1px solid var(--rule)}
.daymark b{font-size:18px;letter-spacing:-.01em}
.daymark span{font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}
.row{display:grid;grid-template-columns:64px 1fr 210px;gap:14px;padding:13px 0;border-bottom:1px solid var(--rule)}
.row .t{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums;padding-top:2px}
.ttl{font-size:16.5px;font-weight:600;letter-spacing:-.01em}
.ttl a{color:var(--ink);text-decoration:none}
.ttl a:hover{color:var(--accent);text-decoration:underline}
.sub{font-size:12.5px;color:var(--muted);margin-top:3px}
.where{font-size:12.5px;text-align:right}
.where b{font-weight:600}
.where span{color:var(--muted)}
.free{display:inline-block;margin-left:7px;font-size:9px;letter-spacing:.12em;text-transform:uppercase;
  background:var(--accent);color:#fff;padding:2px 5px;vertical-align:1px}
.more{margin-top:26px;font-size:14px}
nav.links{margin-top:46px;border-top:1px solid var(--ink);padding-top:18px}
nav.links h2{font-size:10.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);
  font-weight:600;margin:0 0 10px}
nav.links ul{list-style:none;display:flex;flex-wrap:wrap;gap:7px 9px;margin:0 0 22px}
nav.links a{display:inline-block;border:1px solid var(--rule);padding:6px 10px;font-size:13px;
  color:var(--ink);text-decoration:none}
nav.links a:hover{border-color:var(--ink);background:#e8e5de}
nav.links a[aria-current=page]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.foot{margin-top:40px;border-top:1px solid var(--ink);padding-top:14px;font-size:11.5px;color:var(--muted)}
@media(max-width:760px){
  .wrap{padding:0 16px 56px}
  .row{grid-template-columns:52px 1fr;gap:10px}
  .where{grid-column:2;text-align:left}
  .lede{font-size:15.5px}
}
</style>
</head>
<body>
<div class="wrap">

<div class="eyebrow">
  <span><a href="/" style="color:inherit">What's on in Nice</a> · Alpes-Maritimes · 06</span>
  <span>Updated <b>{{ updated }}</b></span>
</div>

<h1>{{ page.h1_pre }}<em>{{ page.h1_em }}</em></h1>
<p class="lede">{{ page.lede }}<span class="fr">{{ page.lede_fr }}</span></p>

<p class="count">{{ page.count }} listed{% if page.window_note %} · {{ page.window_note }}{% endif %}</p>

{#- Things already running go first, under their own heading. Bucketed under
    their start date they would put a heading from two months ago at the top of
    a page about what is on now. #}
{% if page.ongoing %}
<div class="daymark"><b>Running now</b><span>visit any day</span></div>
  {%- for e in page.ongoing %}
  <div class="row">
    <div class="t">{{ e.until }}</div>
    <div>
      <div class="ttl"><a href="/?e={{ e.slug }}">{{ e.title }}</a>{% if e.free %}<span class="free">Free</span>{% endif %}</div>
      {%- if e.note %}<div class="sub">{{ e.note }}</div>{% endif %}
    </div>
    <div class="where"><b>{{ e.town }}</b>{% if e.venue %}<span> · {{ e.venue }}</span>{% endif %}</div>
  </div>
  {%- endfor %}
{% endif %}

{% for day, items in page.days %}
<div class="daymark"><b>{{ day.label }}</b><span>{{ day.year }}</span></div>
  {%- for e in items %}
  <div class="row">
    <div class="t">{{ e.time or "—" }}</div>
    <div>
      <div class="ttl"><a href="/?e={{ e.slug }}">{{ e.title }}</a>{% if e.free %}<span class="free">Free</span>{% endif %}</div>
      {%- if e.note %}<div class="sub">{{ e.note }}</div>{% endif %}
    </div>
    <div class="where"><b>{{ e.town }}</b>{% if e.venue %}<span> · {{ e.venue }}</span>{% endif %}</div>
  </div>
  {%- endfor %}
{% endfor %}

{% if not page.days and not page.ongoing %}
<p class="more">Nothing listed here at the moment. <a href="/">See everything on across the 06 →</a></p>
{% else %}
<p class="more"><a href="/">See everything on across Nice and the 06 →</a>
  {%- if page.truncated %} This page shows the next {{ page.window_days }} days.{% endif %}</p>
{% endif %}

<nav class="links">
  <h2>By town</h2>
  <ul>
    {%- for l in town_links %}
    <li><a href="{{ l.path }}"{% if l.path == page.path %} aria-current="page"{% endif %}>{{ l.name }} <span style="color:var(--muted)">{{ l.count }}</span></a></li>
    {%- endfor %}
  </ul>
  <h2>By what's on</h2>
  <ul>
    {%- for l in cat_links %}
    <li><a href="{{ l.path }}"{% if l.path == page.path %} aria-current="page"{% endif %}>{{ l.name }} <span style="color:var(--muted)">{{ l.count }}</span></a></li>
    {%- endfor %}
  </ul>
</nav>

<div class="foot">
  Scraped daily from public listings and always linked back to the source.
  <a href="/">Home</a> · <a href="/privacy.html">Privacy &amp; legal</a>
</div>

</div>
</body>
</html>
